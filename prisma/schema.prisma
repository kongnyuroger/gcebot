generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../apps/api/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Minimal placeholder proving the pgvector integration end-to-end.
// Real RAG models (Subject, Document, etc.) land in their own feature branch.
model DocumentChunk {
  id        String                       @id @default(cuid())
  content   String
  metadata  Json?
  embedding Unsupported("vector(1536)")
  createdAt DateTime                     @default(now())
}
