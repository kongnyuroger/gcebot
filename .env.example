# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://gcebot:gcebot@localhost:5433/gcebot"

# --- Redis (matches docker-compose.yml) ---
REDIS_URL="redis://localhost:6380"

# --- WhatsApp Cloud API (Meta Graph API v18.0) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- AI provider (OpenAI: gpt-4o-mini for simple queries, gpt-4o for complex ones) ---
OPENAI_API_KEY=""

# --- MTN MoMo Collections API ---
MOMO_API_USER=""
MOMO_API_KEY=""

# --- Admin portal auth (signs TOTP tempTokens and 4h admin session JWTs) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=""

# --- Error tracking (optional) ---
SENTRY_DSN=""
